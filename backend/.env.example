# Copy this file to backend/.env and fill in the values. Never commit .env.

# A long random string, e.g. from: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Neon console -> your project -> Connect -> choose the DIRECT (not pooled) connection string.
# Region should be AWS Europe Central 1 (Frankfurt), Postgres 17.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
