@@ -40,3 +40,26 @@ def test_flow_and_event_cursors_survive_a_source_restart():
     assert [e.type for e in adapter.events(wait_seconds=0)] == ["link_up"]
     state["flows"].append(cycle(2))
     assert [f.octets_fwd for f in adapter._flows()[0]] == [2000]   # and reading carries on normally
+
+
+def test_a_recorded_snapshot_file_replays_through_the_twin(campus, tmp_path):
+    """NFR5 example: a second adapter, picked from the registry, feeds the same pipeline."""
+    import json
+
+    from data_collection.network_adapter import make_adapter
+    from data_collection.preprocessing import Preprocessor
+    from netemu.network import EmulatedNetwork
+    from tests.conftest import START, index_for
+
+    net = EmulatedNetwork(campus, START.replace(hour=9))
+    recording = tmp_path / "recorded.jsonl"
+    with recording.open("w", encoding="utf-8") as handle:
+        for _ in range(3):
+            for _ in range(net.steps_per_cycle()):
+                net.step()
+            handle.write(json.dumps({"snapshot": net.snapshot()}) + chr(10))
+    adapter = make_adapter("snapshot-replay", str(recording))
+    pre = Preprocessor(index_for(campus), 60)
+    pre.process(adapter.poll())                       # first cycle: baseline counters only
+    clean = pre.process(adapter.poll())
+    assert clean is not None and len(clean.links) == len(campus.links)
