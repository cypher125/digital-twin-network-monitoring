@@ -0,0 +1,49 @@
+"""Replay adapter: plays back feed snapshots recorded to a file, one per monitoring cycle.
+
+    manage.py run_twin --adapter snapshot-replay --source recorded.jsonl
+
+Each line of the file is {"snapshot": <a /v1/snapshot body>, "flows": [...], "flow_seconds": n}.
+Useful for re-running a recorded incident through the twin. Read-only, like every adapter.
+"""
+from __future__ import annotations
+
+import json
+import time
+from datetime import UTC, datetime
+from pathlib import Path
+
+from .base import FlowSample, RawBatch, RawEvent
+from .telemetry_http import TelemetryHttpAdapter
+
+
+class SnapshotReplayAdapter:
+    name = "snapshot-replay"
+
+    def __init__(self, source: str):
+        self.path = Path(source)
+        self._lines = [line for line in self.path.read_text(encoding="utf-8").splitlines() if line.strip()]
+        self._next = 0
+
+    def describe(self) -> dict:
+        first = json.loads(self._lines[0])["snapshot"]["timestamp"] if self._lines else None
+        return {"name": f"replay of {self.path.name}", "mode": "replay", "speed": 1.0, "time": first,
+                "cycle_seconds": 60, "cycles": len(self._lines)}
+
+    def poll(self) -> RawBatch:
+        if self._next >= len(self._lines):
+            raise EOFError(f"{self.path.name}: all {len(self._lines)} recorded cycles replayed")
+        record = json.loads(self._lines[self._next])
+        self._next += 1
+        snapshot = record["snapshot"]
+        return RawBatch(source=self.name, measured_at=datetime.fromisoformat(snapshot["timestamp"]),
+                        received_at=datetime.now(UTC),
+                        devices=[TelemetryHttpAdapter._device(d) for d in snapshot["devices"]],
+                        flows=[FlowSample(*f) for f in record.get("flows", [])],
+                        flow_seconds=float(record.get("flow_seconds", 0.0)))
+
+    def events(self, wait_seconds: float) -> list[RawEvent]:
+        time.sleep(min(wait_seconds, 1.0))   # a recording has no live events
+        return []
+
+    def close(self) -> None:
+        pass
